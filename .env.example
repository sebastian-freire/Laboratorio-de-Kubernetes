# Copiar a .env (en la raíz del repo) y completar. No commitear el .env.
# Lo leen: docker compose (POSTGRES_*), el backend y el frontend (solo las variables VITE_*).

# --- Base de datos local (docker compose) ---
POSTGRES_USER=feedback
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=feedback
POSTGRES_PORT=5432

# --- Backend ---
# Debe coincidir con los valores de arriba
DATABASE_URL=postgresql+psycopg://feedback:cambiar_en_local@localhost:5432/feedback
# Base separada que usan las pruebas automáticas (se crea sola al levantar el contenedor). Se borra en cada corrida.
TEST_DATABASE_URL=postgresql+psycopg://feedback:cambiar_en_local@localhost:5432/feedback_test
# Secreto para firmar los JWT: mínimo 32 caracteres. Generar uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio-de-32-o-mas
JWT_EXPIRE_MINUTES=480
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
# Zona horaria para calcular "hoy" y los plazos de feedback
APP_TIMEZONE=America/Montevideo
# Días posteriores a la clase en los que se puede crear o editar feedback
FEEDBACK_WINDOW_DAYS=7
# Contraseña que el seed asigna a todos los usuarios de prueba
SEED_USER_PASSWORD=demo1234

# --- Frontend ---
# URL base de la API (sin barra final)
VITE_API_URL=http://localhost:8000
